{
  "mcpServers": {
    "otto-paperless": {
      "command": "uv",
      "args": [
        "run", "--quiet", "--project", "mcp/paperless",
        "--env-file", ".env.agent", "--env-file", ".env.models",
        "otto-paperless-mcp"
      ]
    },
    "otto-mail": {
      "command": "uv",
      "args": [
        "run", "--quiet", "--project", "mcp/mail",
        "--env-file", ".env.agent", "--env-file", ".env.mail",
        "otto-mail-mcp"
      ]
    }
  }
}
